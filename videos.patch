+
+    // Lazy-load Part intro videos on click (facade pattern)
+    function loadPartVideo(el) {
+      if (el.dataset.loaded) return;
+      const id = el.dataset.videoId;
+      if (!id) return;
+      el.dataset.loaded = 'true';
+      el.innerHTML = '<iframe src="https://www.youtube.com/embed/' + id + '?autoplay=1&rel=0" title="Start at Zero episode" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>';
+    }
+    document.querySelectorAll('.part-video').forEach(el => {
+      el.addEventListener('click', () => loadPartVideo(el));
+      el.addEventListener('keydown', (e) => {
+        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); loadPartVideo(el); }
+      });
+    });
+    // Prevent chapter Watch link clicks from toggling the accordion.
+    document.querySelectorAll('.chapter-watch').forEach(a => {
+      a.addEventListener('click', e => e.stopPropagation());
+    });
   </script>
